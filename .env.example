# Copy to `.env` and fill locally. Never commit real secrets.
# See specs/001-user-auth/plan.md and specs/001-user-auth/quickstart.md

# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ai_interview?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public app origin used by Auth.js (local: http://localhost:3000)
AUTH_URL="http://localhost:3000"

# Google OAuth (Google Cloud Console → OAuth client)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend API key for passwordless magic-link email (Auth.js Resend provider)
AUTH_RESEND_KEY=""

# Verified sender address for magic links (must be allowed in Resend)
EMAIL_FROM="Auth <onboarding@resend.dev>"
