# See https://help.github.com/articles/ignoring-files/
#
# Project focus: BMAD Method + GitHub Spec Kit + the Next.js app.
# KEEP TRACKED (do not ignore):
#   _bmad/  _bmad-output/  .agents/  .specify/  .cursor/skills/
#   src/  public/  package*.json  configs  README / AGENTS / CLAUDE
#
# IGNORE: secrets, builds, dependencies, local caches, uploads, OS junk.
# If a sensitive or generated local artifact appears, add a rule here.

# --- Dependencies ---
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Next.js build & cache ---
/.next/
/out/
/build
.turbo
.swc/

# --- Environment & secrets (never commit) ---
.env
.env.*
!.env.example
!.env*.example
*.secret
*.secrets
secrets/
.secrets/
auth.json
.npmrc
# Keep .npmrc only if it has no tokens; if it has tokens, ignore it.

# --- Logs & debug ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# --- Testing & coverage ---
/coverage
.nyc_output
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/e2e-results/
vitest.config.ts.timestamp-*

# --- TypeScript ---
*.tsbuildinfo
next-env.d.ts

# --- Lint / format caches ---
.eslintcache
.prettiercache
.stylelintcache

# --- Prisma / database local ---
prisma/*.db
prisma/*.db-journal
prisma/dev.db*
*.db
*.db-journal

# --- Uploads & local object-storage mirrors (user resumes, etc.) ---
/uploads/
/tmp/uploads/
/.data/
/storage/local/

# --- Auth / session local artifacts ---
.auth/
*.session.json

# --- Deployment ---
.vercel
.netlify

# --- OS files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- Editors & local IDE state (keep Spec Kit / Cursor skills tracked) ---
.idea/
*.iml
*.swp
*.swo
*~
.project
.classpath
.settings/
*.code-workspace
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
# Do NOT ignore .cursor/skills or .specify — Spec Kit tooling
.cursor-tmp/
.cursor/*.log

# --- Certificates & keys ---
*.pem
*.key
*.p12
*.pfx
credentials.json
*-credentials.json
service-account*.json
*-service-account.json
.aws/
.gcloud/

# --- Misc local / temp ---
.cache/
tmp/
temp/
*.local
*.bak
*.orig
