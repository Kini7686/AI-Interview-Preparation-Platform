# See https://help.github.com/articles/ignoring-files/

# --- Dependencies (reinstall with npm install) ---
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Next.js build & cache ---
/.next/
/out/
/build
.turbo

# --- Environment & secrets (never commit) ---
.env
.env.*
!.env.example

# --- Logs & debug ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# --- Testing & coverage ---
/coverage
.nyc_output
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# --- TypeScript ---
*.tsbuildinfo
next-env.d.ts

# --- Lint / format caches ---
.eslintcache
.prettiercache

# --- Deployment ---
.vercel

# --- OS files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- Editors & local IDE state ---
.idea/
*.iml
*.swp
*.swo
*~
.project
.classpath
.settings/
*.code-workspace

# --- Certificates & keys ---
*.pem
*.key
*.p12
*.pfx
credentials.json
*-credentials.json
service-account*.json

# --- Misc local / temp ---
.cache/
tmp/
temp/
*.local
