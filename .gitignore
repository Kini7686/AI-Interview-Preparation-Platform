# See https://help.github.com/articles/ignoring-files/
# Keep this file current: if a generated/local/secret artifact appears in the
# working tree and must not ship to GitHub, add a rule here immediately.

# --- Dependencies ---
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Next.js build & cache ---
/.next/
/out/
/build
.turbo
.swc/

# --- Environment & secrets (never commit) ---
.env
.env.*
!.env.example
!.env*.example

# --- Logs & debug ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# --- Testing & coverage ---
/coverage
.nyc_output
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/e2e-results/
vitest.config.ts.timestamp-*

# --- TypeScript ---
*.tsbuildinfo
next-env.d.ts

# --- Lint / format caches ---
.eslintcache
.prettiercache
.stylelintcache

# --- Prisma / database local ---
prisma/*.db
prisma/*.db-journal
prisma/dev.db*
*.db
*.db-journal

# --- Uploads & local object-storage mirrors ---
/uploads/
/tmp/uploads/
/.data/
/storage/local/

# --- Auth / session local artifacts ---
.auth/
*.session.json

# --- Deployment ---
.vercel
.netlify

# --- OS files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- Editors & local IDE state ---
.idea/
*.iml
*.swp
*.swo
*~
.project
.classpath
.settings/
*.code-workspace
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# --- Certificates & keys ---
*.pem
*.key
*.p12
*.pfx
credentials.json
*-credentials.json
service-account*.json

# --- Misc local / temp / agent noise ---
.cache/
tmp/
temp/
*.local
*.bak
*.orig
.cursor-tmp/
